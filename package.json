      "!assets/fabric/1.21.7.json",
      "!assets/fabric/libraries/net/fabricmc/intermediary/1.21.7/**",
      "!assets/mods/nova-menu-1.21.8.jar",
      "!assets/fabric/1.21.8.json",
      "!assets/fabric/libraries/net/fabricmc/intermediary/1.21.8/**",
      "!assets/mods/nova-menu-1.21.9.jar",
      "!assets/fabric/1.21.9.json",
      "!assets/fabric/libraries/net/fabricmc/intermediary/1.21.9/**",
      "!assets/mods/nova-menu-26.1.jar",
      "!assets/fabric/26.1.json",
      "!assets/fabric/libraries/net/fabricmc/intermediary/26.1/**",
      "!assets/mods/nova-menu-26.1.1.jar",
      "!assets/fabric/26.1.1.json",
      "!assets/fabric/libraries/net/fabricmc/intermediary/26.1.1/**",
      "!assets/mods/nova-menu-26.1.2.jar",
      "!assets/fabric/26.1.2.json",
      "!assets/fabric/libraries/net/fabricmc/intermediary/26.1.2/**",
      "!assets/mods/nova-menu-26.2.jar",
      "!assets/fabric/26.2.json",
      "!assets/fabric/libraries/net/fabricmc/intermediary/26.2/**"
    ]
  }
}
