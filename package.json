{
  "name": "nova-launcher",
  "version": "0.2.14-beta.2",
  "description": "Nova Launcher para Minecraft",
  "author": "Astrion Studio",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node tests/check.js && node tests/ui.js",
    "smoke": "node scripts/smoke.js",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "electron-updater": "^6.3.0",
    "minecraft-launcher-core": "^3.18.1",
    "msmc": "^5.0.2",
    "discord-rpc": "^4.0.1"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "jsdom": "^29.1.0"
  },
  "build": {
    "appId": "com.nova.launcher",
    "productName": "Nova Launcher",
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false,
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "language": "3082",
      "shortcutName": "Nova Launcher",
      "runAfterFinish": true
    },
    "publish": {
      "provider": "github",
      "owner": "JustMarcoDev",
      "repo": "nova-launcher",
      "releaseType": "release"
    },
    "copyright": "Copyright © 2026 Astrion Studio",
    "files": [
      "**/*",
      "!tests/**",
      "!scripts/**",
      "!*.bat",
      "!README.md"
    ]
  }
}
