{
  "name": "nova-launcher",
  "version": "0.2.16-beta.13",
  "novaPresence": "",
  "description": "Nova Launcher para Minecraft",
  "author": "Astrion Studio",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node tests/check.js && node tests/ui.js",
    "smoke": "node scripts/smoke.js",
    "recursos": "node scripts/recursos.js bajar nova-bg.nvb && node scripts/recursos.js mods",
    "predist": "npm run recursos",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "electron-updater": "^6.8.0",
    "minecraft-launcher-core": "^3.18.1",
    "msmc": "^5.0.2",
    "discord-rpc": "^4.0.1"
  },
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^25.1.8",
    "jsdom": "^29.1.0"
  },
  "build": {
    "appId": "com.nova.launcher",
    "productName": "Nova Launcher",
    "win": {
      "target": "nsis",
      "signAndEditExecutable": true,
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "language": "3082",
      "shortcutName": "Nova Launcher",
      "runAfterFinish": true,
      "allowElevation": true,
      "perMachine": false
    },
    "publish": {
      "provider": "github",
      "owner": "JustMarcoDev",
      "repo": "nova-launcher",
      "releaseType": "release"
    },
    "copyright": "Copyright © 2026 Astrion Studio",
    "compression": "maximum",
    "generateUpdatesFilesForAllChannels": true,
    "files": [
      "**/*",
      "!tests/**",
      "!scripts/**",
      "!servidor/**",
      "!*.bat",
      "!README.md",
      "!assets/discord-logo.png",
      "!assets/nova-earth.nvb",
      "!assets/nova-nebulosa.nvb",
      "!js/vista-previa.js",
      "!mod/**",
      "!docs/**",
      "!novapack/**",
      "!assets/mods/nova-menu-1.20.jar",
      "!assets/fabric/1.20.json",
      "!assets/fabric/libraries/net/fabricmc/intermediary/1.20/**",
      "!assets/mods/nova-menu-1.20.1.jar",
      "!assets/fabric/1.20.1.json",
      "!assets/fabric/libraries/net/fabricmc/intermediary/1.20.1/**",
      "!assets/mods/nova-menu-1.20.2.jar",
      "!assets/fabric/1.20.2.json",
      "!assets/fabric/libraries/net/fabricmc/intermediary/1.20.2/**",
      "!assets/mods/nova-menu-1.20.3.jar",
      "!assets/fabric/1.20.3.json",
      "!assets/fabric/libraries/net/fabricmc/intermediary/1.20.3/**",
      "!assets/mods/nova-menu-1.20.4.jar",
      "!assets/fabric/1.20.4.json",
      "!assets/fabric/libraries/net/fabricmc/intermediary/1.20.4/**",
      "!assets/mods/nova-menu-1.20.5.jar",
      "!assets/fabric/1.20.5.json",
      "!assets/fabric/libraries/net/fabricmc/intermediary/1.20.5/**",
      "!assets/mods/nova-menu-1.20.6.jar",
      "!assets/fabric/1.20.6.json",
      "!assets/fabric/libraries/net/fabricmc/intermediary/1.20.6/**",
      "!assets/mods/nova-menu-1.21.jar",
      "!assets/fabric/1.21.json",
      "!assets/fabric/libraries/net/fabricmc/intermediary/1.21/**",
      "!assets/mods/nova-menu-1.21.10.jar",
      "!assets/fabric/1.21.10.json",
      "!assets/fabric/libraries/net/fabricmc/intermediary/1.21.10/**",
      "!assets/mods/nova-menu-1.21.2.jar",
      "!assets/fabric/1.21.2.json",
      "!assets/fabric/libraries/net/fabricmc/intermediary/1.21.2/**",
      "!assets/mods/nova-menu-1.21.3.jar",
      "!assets/fabric/1.21.3.json",
      "!assets/fabric/libraries/net/fabricmc/intermediary/1.21.3/**",
      "!assets/mods/nova-menu-1.21.4.jar",
      "!assets/fabric/1.21.4.json",
      "!assets/fabric/libraries/net/fabricmc/intermediary/1.21.4/**",
      "!assets/mods/nova-menu-1.21.5.jar",
      "!assets/fabric/1.21.5.json",
      "!assets/fabric/libraries/net/fabricmc/intermediary/1.21.5/**",
